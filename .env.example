# Required. Encrypts credential tokens at rest. Generate with:
#   openssl rand -base64 32
# Changing this makes every stored credential unreadable.
OMNI_ENCRYPTION_KEY=

# Optional.
OMNI_HOST=127.0.0.1
OMNI_PORT=9000
OMNI_DB_PATH=./omnigateway.db

# Where the day ends, for the daily usage buckets, in minutes east of UTC.
# 420 = Asia/Jakarta (UTC+7); 0 = UTC; -480 = US Pacific standard time.
# Defaults to this host's own offset at boot when unset, which is what a
# single-node install wants. Setting it to anything but the host's offset, or
# changing it later, splits the day in progress across two rows once — the
# same split a DST-zone host gets on its first restart after each transition,
# because the default is read at boot and a fixed offset does not follow DST.
# In cluster mode set it explicitly: replicas whose hosts disagree split every
# day. An unparseable or out-of-range value is not fatal; the host offset is
# used and the boot line says so.
# OMNI_DAY_OFFSET_MINUTES=420

# Cluster mode: several replicas serving one installation. Switching it on
# requires both URLs — Postgres replaces the SQLite file above, Redis is the
# coordinator every replica shares for rate-limit counters, sessions, leases
# and push fan-out. With the switch off, both must stay unset. See README
# "Running more than one gateway".
# OMNI_CLUSTER_MODE=true
# OMNI_DATABASE_URL=postgres://omni:secret@localhost:5432/omni
# OMNI_REDIS_URL=redis://localhost:6379

# Origin providers redirect back to during OAuth. Derived from host and port
# when unset. Set this if the gateway sits behind a reverse proxy.
# OMNI_BASE_URL=https://gateway.example.com
# OMNI_BASE_URL=

# Permits request and response body capture on this installation. Read at boot.
# This is only half of it: capture also needs the bodyLoggingEnabled setting,
# which is off by default, so an admin session on its own cannot start recording
# prompts. Leave unset and the setting does nothing at all. See "Recording
# bodies" in README.md before turning it on — captured bodies are encrypted with
# OMNI_ENCRYPTION_KEY, expire on the log retention window, and are capped at
# 100,000 requests, which is roughly 100 GB of disk in the worst case.
# OMNI_BODY_LOGGING_ALLOWED=1

# Stdout threshold: debug, info, warn, error. An unrecognised value is not
# fatal; the boot line names what was ignored.
# OMNI_LOG_LEVEL=info

# Where something already captured this process's stdout, so the Console screen
# can read it back. Names an existing file; does not create or redirect one.
# Unset means look for the systemd journal, then report that nothing captured it.
# OMNI_LOG_FILE=/var/log/omnigateway.log

# Serve a different console build. Unset means the bundle shipped with the
# server. Taken literally when set — a wrong path is reported, not fallen back.
# OMNI_STATIC_DIR=

# Which installation the CLI acts on when --root is not passed. Read from your
# shell and never from a root's own .env, because a variable that selects the
# installation cannot live inside the installation it selects.
# OMNI_ROOT=~/.config/omnigateway

# Registry `omni plugin install <name>` resolves through. Must be https://.
# OMNI_PLUGIN_REGISTRY=https://registry.npmjs.org

# Telemetry. All optional and all off by default: with no metrics token the
# /metrics route is not registered at all, and with no OTLP endpoint tracing
# allocates no spans.
# OMNI_METRICS_TOKEN=
# OMNI_METRICS_MAX_SERIES=5000
# OMNI_OTLP_ENDPOINT=http://collector:4318
# OMNI_OTLP_HEADERS=authorization=Bearer xyz,x-tenant=acme
# OMNI_TRACE_SAMPLE=1.0

# Client identity profile overrides (Tasks 8B, 8C). All optional; every one has
# a working default baked into the profile, so an empty file is a valid config.
# These are read once at module load, not per request. A value that is not 1-200
# printable ASCII characters is ignored and the default is used.
#
# Version pins. These move when the upstream CLI ships a release; bumping them
# here avoids a code change — except OMNI_ANTHROPIC_CLI_VERSION, which is also
# hashed into `cc_version` together with a salt pinned in body.ts. Changing the
# version alone makes that suffix wrong silently; the salt moves with it.
OMNI_ANTHROPIC_CLI_VERSION=
OMNI_OPENAI_CLI_VERSION=
OMNI_KIMI_CLI_VERSION=
OMNI_KILO_CLI_VERSION=
OMNI_MUSE_CLI_VERSION=
OMNI_ANTIGRAVITY_IDE_VERSION=
# Weaker than the rest: xAI resolves this from a build-time variable, so the
# default is an observation off the wire rather than a quote. The proxy gates on
# it, so a stale value is an operator fix here, not a release.
OMNI_GROK_CLI_VERSION=
#
# Individual header values. Set one to override just that header. The Stainless
# OS and Arch default to the real host; the runtime is always reported as node.
OMNI_UA_ANTHROPIC=
OMNI_ANTHROPIC_STAINLESS_OS=
OMNI_ANTHROPIC_STAINLESS_ARCH=
OMNI_ANTHROPIC_STAINLESS_PACKAGE_VERSION=
OMNI_ANTHROPIC_STAINLESS_RUNTIME_VERSION=
OMNI_UA_OPENAI=
OMNI_OPENAI_UA_PLATFORM=
OMNI_OPENAI_UA_ARCH=
OMNI_OPENAI_ORIGINATOR=
OMNI_UA_KIMI=
OMNI_UA_GROK=
OMNI_UA_KILO=
OMNI_KILO_EDITOR_NAME=
OMNI_UA_MUSE=
OMNI_MUSE_API_VERSION=
OMNI_UA_ANTIGRAVITY=
#
# Header wire order. A comma-separated list of header names. Replaces the
# profile order wholesale; names not in the list are appended in profile order.
# Casing here is what goes on the wire.
OMNI_ORDER_ANTHROPIC=
OMNI_ORDER_OPENAI=
OMNI_ORDER_KIMI=
OMNI_ORDER_GROK=
OMNI_ORDER_KILO=
OMNI_ORDER_MUSE=
OMNI_ORDER_ANTIGRAVITY=
