+//! OpenAI Responses request assembly and streaming decoding.
+pub mod decode;
+mod identity;
+#[cfg(test)]
+mod identity_tests;
+mod lite;
+#[cfg(test)]
+mod lite_tests;
+mod oauth;
+mod profile;
+mod wire;
+/// Credential-selected OpenAI Responses codec.
+pub struct OpenAiCodec;
+impl crate::codec::ProviderCodec for OpenAiCodec {
+    type State = bool;
+    fn build_request(&self, input: &CodecInput<'_>) -> Result<CodecRequest<bool>, GatewayError> {
+        build_request(*input)
+    }
+    fn decoder(
+        &self,
+        state: bool,
+        _headers: &crate::http::Headers,
+    ) -> Box<dyn crate::codec::StreamDecoder> {
+        Box::new(decode::OpenAiDecoder::new(state))
+    }
+}
+/// API-key leg only; OAuth identity/transport is the next migration increment.
+pub struct OpenAiApiKeyCodec;
+impl crate::codec::ProviderCodec for OpenAiApiKeyCodec {
+    type State = bool;
+    fn build_request(&self, input: &CodecInput<'_>) -> Result<CodecRequest<bool>, GatewayError> {
+        build_api_key_request(*input)
+    }
+    fn decoder(
+        &self,
+        state: bool,
+        _headers: &crate::http::Headers,
+    ) -> Box<dyn crate::codec::StreamDecoder> {
+        Box::new(decode::OpenAiDecoder::new(state))
+    }
+}
+use crate::codec::{CodecHttpRequest, CodecInput, CodecRequest};
+use omni_ir::{
+    deep,
+    error::{ErrorCode, GatewayError},
+};
+
+/// Capture OpenAI profile environment once, before serving requests.
+/// Hosts must call this at startup; library users otherwise capture on first use.
+pub fn initialize() {
+    profile::initialize();
+}
+
+/// API-key request boundary: assembly and temporary arbitrary JSON are scoped;
+/// only strings, headers and a boolean escape.
+pub fn build_api_key_request(input: CodecInput<'_>) -> Result<CodecRequest<bool>, GatewayError> {
+    build_mode(input, false)
+}
+fn build_request(input: CodecInput<'_>) -> Result<CodecRequest<bool>, GatewayError> {
+    build_mode(input, input.credentials.access_token.is_some())
+}
+fn build_mode(input: CodecInput<'_>, oauth: bool) -> Result<CodecRequest<bool>, GatewayError> {
+    let token = if oauth {
+        &input.credentials.access_token
+    } else {
+        &input.credentials.api_key
+    }
+    .as_ref()
+    .ok_or_else(|| GatewayError::new(ErrorCode::Auth, "openai credential has no token"))?;
+    Ok(deep::scope(|| {
+        let (mut body, degradations, key, mut protocol) =
+            wire::encode_mode(input.request, input.model, oauth.then_some(&input));
+        if oauth && !input.model.is_empty() && input.model.bytes().all(|b| (33..=126).contains(&b))
+        {
+            let tier = body
+                .get("service_tier")
+                .and_then(serde_json::Value::as_str)
+                .filter(|s| {
+                    !s.is_empty() && s.bytes().all(|b| (33..=126).contains(&b)) && !s.contains(';')
+                });
+            protocol.push((
+                "x-codex-routing-hint".into(),
+                format!(
+                    "model={}{}",
+                    input.model,
+                    tier.map_or(String::new(), |t| format!(";tier={t}"))
+                ),
+            ));
+        }
+        deep::insert(&mut body, "stream".into(), true.into());
+        let mut ordered = serde_json::Map::new();
+        for name in [
+            "model",
+            "stream",
+            "service_tier",
+            "input",
+            "instructions",
+            "tools",
+            "tool_choice",
+            "parallel_tool_calls",
+            "reasoning",
+            "store",
+            "stream_options",
+            "include",
+            "prompt_cache_key",
+            "text",
+            "client_metadata",
+            "access_programs",
+            "metadata",
+        ] {
+            if let Some(value) = body.shift_remove(name) {
+                deep::insert(&mut ordered, name.into(), value);
+            }
+        }
+        for (name, value) in body {
+            deep::insert(&mut ordered, name, value);
+        }
+        let body = deep::Owned(serde_json::Value::Object(ordered));
+        protocol.extend(vec![
+            ("x-client-request-id".into(), key.clone()),
+            ("session-id".into(), key.clone()),
+            ("thread-id".into(), key),
+        ]);
+        if oauth {
+            protocol.push(("content-encoding".into(), "zstd".into()));
+        }
+        protocol.extend(vec![
+            ("content-type".into(), "application/json".into()),
+            ("authorization".into(), format!("Bearer {token}")),
+        ]);
+        if oauth {
+            if let Some(account) = input
+                .credentials
+                .provider_data
+                .get("accountId")
+                .and_then(serde_json::Value::as_str)
+            {
+                protocol.push(("chatgpt-account-id".into(), account.into()));
+            }
+            protocol.push(("host".into(), "chatgpt.com".into()));
+        }
+        let headers = profile::headers(protocol);
+        let native = input
+            .request
+            .vendor_bag("openai")
+            .and_then(|b| b.get("include"))
+            .and_then(serde_json::Value::as_array)
+            .is_some_and(|a| a.iter().any(|v| v == "reasoning.encrypted_content"));
+        CodecRequest {
+            request: CodecHttpRequest {
+                url: if oauth {
+                    "https://chatgpt.com/backend-api/codex/responses"
+                } else {
+                    "https://api.openai.com/v1/responses"
+                }
+                .into(),
+                method: "POST".into(),
+                headers,
+                body: omni_ir::jsjson::to_string(&body.0),
+                body_encoding: oauth.then_some(crate::http::BodyEncoding::Zstd),
+            },
+            decode_state: native,
+            degradations,
+            cloaked_tools: None,
+        }
+    }))
+}
diff --git a/crates/omni-providers/src/openai/oauth.rs b/crates/omni-providers/src/openai/oauth.rs
new file mode 100644
index 00000000..b72b8f9a
--- /dev/null
+++ b/crates/omni-providers/src/openai/oauth.rs
@@ -0,0 +1,87 @@
+use omni_crypto::codex;
+use omni_ir::jsjson;
+use serde_json::{Value, json};
+pub(crate) struct Catalog {
+    pub lite: bool,
+    pub effort: &'static str,
+    pub verbosity: &'static str,
+    pub review: bool,
+    pub updates: bool,
+}
+pub(crate) fn catalog(model: &str) -> Catalog {
+    Catalog {
+        lite: model != "gpt-5.5",
+        effort: if matches!(
+            model,
+            "gpt-6-sol"
+                | "gpt-6-luna"
+                | "gpt-5.6-terra"
+                | "gpt-5.6-luna"
+                | "gpt-daybreak-red-latest"
+                | "gpt-5.5"
+                | "codex-auto-review"
+        ) {
+            "medium"
+        } else {
+            "low"
+        },
+        verbosity: if model == "gpt-daybreak-red-latest" {
+            "high"
+        } else {
+            "low"
+        },
+        review: matches!(
+            model,
+            "gpt-6-astra" | "gpt-6.1-sol" | "gpt-6.1-terra" | "gpt-6-sol"
+        ),
+        updates: matches!(model, "gpt-6-astra" | "gpt-6.1-sol" | "gpt-6.1-terra"),
+    }
+}
+pub(crate) fn is_effort(e: &str) -> bool {
+    matches!(
+        e,
+        "none" | "minimal" | "low" | "medium" | "high" | "xhigh" | "max" | "ultra" | "persistent"
+    )
+}
+pub(crate) fn turn(
+    opts: &crate::codec::CodecInput<'_>,
+    key: &str,
+    seed: &str,
+    built: &Value,
+    effort: &str,
+) -> (Value, Vec<(String, String)>) {
+    let secrets = super::identity::secrets_from_map(&opts.credentials.provider_data);
+    let account = opts
+        .credentials
+        .provider_data
+        .get("accountId")
+        .and_then(Value::as_str);
+    let installation = secrets.installation_id.unwrap_or_else(|| {
+        codex::uuid_v4_from(&format!("installation:{}", account.unwrap_or(seed)))
+    });
+    let window = format!("{key}:0");
+    let turn = &built["turnId"];
+    let started = built["startedAt"].as_f64().unwrap_or(0.0);
+    let c = catalog(opts.model);
+    let meta = json!({"installation_id":installation,"session_id":key,"thread_id":key,"agent_name":"/root","turn_id":turn,"window_id":window,"window_number":0,"context_window_id":codex::uuid_v7_from(&codex::keyed(secrets.id_salt.as_deref(),&format!("{key}:context-window")),codex::thread_instant(key,started)),"request_kind":"turn","history_initialization":"new","root_turn_id":turn,"thread_source":"user","turn_trigger":"user","sandbox":super::profile::sandbox(),"sandbox_mode":"workspace-write","auto_review_enabled":false,"node_repl_auto_review_required":c.review,"node_repl_disabled":false,"turn_started_at_unix_ms":started,"analytics_enabled":false,"model":opts.model,"reasoning_effort":effort});
+    let mut ascii = String::new();
+    for unit in jsjson::to_string(&meta).encode_utf16() {
+        if (32..=126).contains(&unit) {
+            ascii.push(char::from_u32(u32::from(unit)).unwrap_or('?'));
+        } else {
+            ascii.push_str(&format!("\\u{unit:04x}"));
+        }
+    }
+    let metadata = json!({"turn_id":turn,"thread_id":key,"x-codex-turn-metadata":ascii,"mcp_attribution":"{\"status\":\"none\"}","guardian_credits_requested":"true","x-codex-installation-id":installation,"x-codex-window-id":window,"root_turn_id":turn,"session_id":key});
+    let mut headers = vec![
+        ("x-codex-window-id".into(), window),
+        ("x-codex-turn-metadata".into(), ascii),
+    ];
+    if c.lite {
+        headers.push((
+            "x-openai-internal-codex-responses-lite".into(),
+            "true".into(),
+        ));
+    }
+    (metadata, headers)
+}
diff --git a/crates/omni-providers/src/openai/profile.rs b/crates/omni-providers/src/openai/profile.rs
new file mode 100644
index 00000000..04883a84
--- /dev/null
+++ b/crates/omni-providers/src/openai/profile.rs
@@ -0,0 +1,143 @@
+use std::{collections::HashMap, sync::OnceLock};
+static ENV: OnceLock<HashMap<String, String>> = OnceLock::new();
+/// Capture the profile before serving requests, like the frozen module import.
+pub(super) fn initialize() {
+    let _ = raw("OMNI_OPENAI_CLI_VERSION");
+}
+fn raw(name: &str) -> Option<&'static String> {
+    capture(|| {
+        std::env::vars_os()
+            .filter_map(|(k, v)| Some((k.into_string().ok()?, v.into_string().ok()?)))
+            .filter(|(k, _)| {
+                k.starts_with("OMNI_OPENAI_") || k == "OMNI_UA_OPENAI" || k == "OMNI_ORDER_OPENAI"
+            })
+            .collect()
+    });
+    ENV.get().and_then(|env| env.get(name))
+}
+fn capture(source: impl FnOnce() -> HashMap<String, String>) {
+    ENV.get_or_init(source);
+}
+fn safe(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 200 && s.bytes().all(|b| (32..=126).contains(&b))
+}
+fn env(name: &str, fallback: &str) -> String {
+    raw(name)
+        .filter(|s| safe(s))
+        .cloned()
+        .unwrap_or_else(|| fallback.into())
+}
+pub(crate) fn sandbox() -> &'static str {
+    let platform = env("OMNI_OPENAI_UA_PLATFORM", "Windows 10.0.26200");
+    if platform.starts_with("Windows") {
+        "windows_elevated"
+    } else if platform.starts_with("Mac OS") || platform.starts_with("macOS") {
+        "seatbelt"
+    } else {
+        "seccomp"
+    }
+}
+pub(crate) fn headers(extra: Vec<(String, String)>) -> Vec<(String, String)> {
+    initialize();
+    let version = env("OMNI_OPENAI_CLI_VERSION", "0.165.0");
+    let origin = env("OMNI_OPENAI_ORIGINATOR", "codex-tui");
+    let platform = env("OMNI_OPENAI_UA_PLATFORM", "Windows 10.0.26200");
+    let arch = env("OMNI_OPENAI_UA_ARCH", "x86_64");
+    let terminal = env("OMNI_OPENAI_UA_TERMINAL", "WindowsTerminal");
+    let ua = env(
+        "OMNI_UA_OPENAI",
+        &format!("{origin}/{version} ({platform}; {arch}) {terminal} ({origin}; {version})"),
+    );
+    let mut base: Vec<(String, String)> = vec![
+        ("user-agent", ua),
+        ("originator", origin),
+        ("version", version),
+        ("x-codex-beta-features", "remote_compaction_v2".into()),
+        ("accept", "text/event-stream".into()),
+    ]
+    .into_iter()
+    .map(|(k, v)| (k.into(), v))
+    .collect();
+    for pair in extra {
+        if let Some(slot) = base
+            .iter_mut()
+            .find(|(k, _)| k.eq_ignore_ascii_case(&pair.0))
+        {
+            *slot = pair;
+        } else {
+            base.push(pair);
+        }
+    }
+    let parts: Vec<_> = raw("OMNI_ORDER_OPENAI")
+        .map_or("", String::as_str)
+        .split(',')
+        .map(omni_ir::js::trim)
+        .filter(|s| safe(s))
+        .collect();
+    let default = "version,x-codex-beta-features,x-codex-window-id,x-codex-turn-metadata,x-openai-internal-codex-responses-lite,x-codex-routing-hint,x-client-request-id,session-id,thread-id,accept,content-encoding,content-type,authorization,chatgpt-account-id,originator,user-agent,host,content-length";
+    let order = if parts.is_empty() {
+        default.split(',').collect()
+    } else {
+        parts
+    };
+    let mut out = Vec::new();
+    for name in order {
+        if let Some(i) = base.iter().position(|(k, _)| k.eq_ignore_ascii_case(name)) {
+            out.push(base.remove(i));
+        }
+    }
+    out.extend(base);
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn environment_oracle_subprocess() {
+        if std::env::var_os("OPENAI_PROFILE_CHILD").is_some() {
+            crate::openai::initialize();
+            let before = super::headers(vec![]);
+            // Rust 2024 set_var requires unsafe. Change the environment source
+            // at the same capture boundary instead, without process mutation.
+            super::capture(|| {
+                std::collections::HashMap::from([
+                    ("OMNI_OPENAI_CLI_VERSION".into(), "later".into()),
+                    ("OMNI_UA_OPENAI".into(), "later-agent".into()),
+                    ("OMNI_ORDER_OPENAI".into(), "user-agent".into()),
+                ])
+            });
+            assert_eq!(super::headers(vec![]), before);
+            let extra = vec![
+                ("Accept".into(), "application/json".into()),
+                ("X-Extra".into(), "extra".into()),
+            ];
+            let actual = super::headers(extra);
+            let out=std::process::Command::new("bun").args(["-e",r#"const {openaiProfile:p}=await import('./packages/providers/src/openai/profile.ts');const {mergeHeaders,orderHeaders}=await import('./packages/providers/src/headers.ts');process.env.OMNI_OPENAI_CLI_VERSION='later';console.log(JSON.stringify(orderHeaders(mergeHeaders(p.headers,[['Accept','application/json'],['X-Extra','extra']]),p.order)))"#]).current_dir(concat!(env!("CARGO_MANIFEST_DIR"),"/../..")).output().expect("oracle");
+            assert!(out.status.success());
+            let expected: serde_json::Value = serde_json::from_slice(&out.stdout).expect("headers");
+            assert_eq!(serde_json::json!(actual), expected);
+            return;
+        }
+        for value in ["startup", "", "bad\r\nvalue", "日本語"] {
+            let out = std::process::Command::new(std::env::current_exe().expect("exe"))
+                .args([
+                    "--exact",
+                    "openai::profile::tests::environment_oracle_subprocess",
+                ])
+                .env("OPENAI_PROFILE_CHILD", "1")
+                .env("OMNI_OPENAI_CLI_VERSION", value)
+                .env("OMNI_OPENAI_UA_PLATFORM", "Linux")
+                .env(
+                    "OMNI_ORDER_OPENAI",
+                    " X-Extra, ACCEPT, user-agent, version,accept ",
+                )
+                .output()
+                .expect("child");
+            assert!(
+                out.status.success(),
+                "{}",
+                String::from_utf8_lossy(&out.stderr)
+            );
+        }
+    }
+}
diff --git a/crates/omni-providers/src/openai/wire.rs b/crates/omni-providers/src/openai/wire.rs
new file mode 100644
index 00000000..fc782285
--- /dev/null
+++ b/crates/omni-providers/src/openai/wire.rs
@@ -0,0 +1,437 @@
+use omni_ir::{
+    deep, jsjson,
+    request::{
+        CONTEXT_1M_BETA, ChatRequest, ContentBlock, ReasoningConfig, ReasoningDisplay, Role,
+        ToolChoice, ToolDef,
+    },
+};
+use serde_json::{Map, Value, json};
+use sha2::{Digest, Sha256};
+fn note(notes: &mut Vec<String>, s: impl Into<String>) {
+    let s = s.into();
+    if !notes.contains(&s) {
+        notes.push(s);
+    }
+}
+fn uuid(s: &str) -> bool {
+    super::identity::is_uuid(s)
+}
+fn thread(seed: &str) -> String {
+    let hash = Sha256::digest(format!("thread:{seed}"));
+    let offset = hash[..6].iter().fold(0u64, |v, b| v * 256 + u64::from(*b)) % 31_536_000_000;
+    let ts = 1_790_812_800_000u64 - 31_536_000_000 + offset;
+    let hash = Sha256::digest(seed);
+    let hex = format!(
+        "{ts:012x}{:04x}{:04x}{}",
+        (u16::from_be_bytes([hash[6], hash[7]]) & 0x0fff) | 0x7000,
+        (u16::from_be_bytes([hash[8], hash[9]]) & 0x3fff) | 0x8000,
+        hash[10..16]
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect::<String>()
+    );
+    format!(
+        "{}-{}-{}-{}-{}",
+        &hex[..8],
+        &hex[8..12],
+        &hex[12..16],
+        &hex[16..20],
+        &hex[20..]
+    )
+}
+#[cfg(test)]
+pub(crate) fn encode(req: &ChatRequest, model: &str) -> (Map<String, Value>, Vec<String>, String) {
+    let (body, notes, key, _) = encode_mode(req, model, None);
+    (body, notes, key)
+}
+type Encoded = (
+    Map<String, Value>,
+    Vec<String>,
+    String,
+    Vec<(String, String)>,
+);
+pub(crate) fn encode_mode(
+    req: &ChatRequest,
+    model: &str,
+    oauth: Option<&crate::codec::CodecInput<'_>>,
+) -> Encoded {
+    let mut notes = Vec::new();
+    let mut input = Vec::new();
+    let mut turns = Vec::new();
+    let mut provenance = Vec::new();
+    let mut turn: i64 = -1;
+    if req
+        .betas
+        .as_ref()
+        .is_some_and(|b| b.iter().any(|x| x == CONTEXT_1M_BETA))
+    {
+        note(&mut notes, "openai:context-1m-dropped");
+    }
+    for message in &req.messages {
+        let role = if message.role == Role::System {
+            note(&mut notes, "openai:system-turn-as-developer");
+            "developer"
+        } else {
+            message.role.as_str()
+        };
+        let mut parts = Vec::new();
+        let mut tool_parts = Vec::new();
+        let flush = |parts: &mut Vec<Value>, input: &mut Vec<Value>| {
+            if !parts.is_empty() {
+                let mut m = Map::new();
+                deep::insert(&mut m, "type".into(), json!("message"));
+                deep::insert(&mut m, "role".into(), json!(role));
+                deep::insert(
+                    &mut m,
+                    "content".into(),
+                    Value::Array(std::mem::take(parts)),
+                );
+                input.push(Value::Object(m));
+            }
+        };
+        let mut opened = false;
+        for block in &message.content {
+            if message.role == Role::User
+                && !opened
+                && !matches!(block, ContentBlock::ToolResult(_))
+            {
+                opened = true;
+                turn += 1;
+            }
+            let before = input.len();
+            let old_parts = parts.len();
+            match block {
+ ContentBlock::Text(t)=>parts.push(json!({"type":if role=="assistant"{"output_text"}else{"input_text"},"text":t.text})),
+ ContentBlock::Image(i)=>parts.push(json!({"type":"input_image","image_url":format!("data:{};base64,{}",i.media_type,i.data)})),
+ ContentBlock::Thinking(_)=>note(&mut notes,"openai:thinking-dropped"),
+ ContentBlock::ToolUse(u)=>{flush(&mut parts,&mut input);input.push(json!({"type":"function_call","call_id":u.id,"name":u.name,"arguments":jsjson::to_string(&u.input)}));},
+ ContentBlock::ToolResult(r)=>{
+ if r.native.is_some(){note(&mut notes,"openai:anthropic-native-block-dropped");}flush(&mut parts,&mut input);
+ let files=crate::tool_result_files::responses_files(r.files.as_deref().unwrap_or_default());
+ input.push(json!({"type":"function_call_output","call_id":r.tool_use_id,"output":crate::tool_result_files::with_file_text(&r.content,&files.text)}));
+ if let Some(images)=&r.images{note(&mut notes,"openai:tool-result-images-moved");for i in images{parts.push(json!({"type":"input_image","image_url":format!("data:{};base64,{}",i.media_type,i.data)}));}}
+ if !files.parts.is_empty(){note(&mut notes,"openai:tool-result-files-moved");parts.extend(files.parts);}
+ if !files.text.is_empty(){note(&mut notes,"openai:tool-result-files-inlined");}
+ if files.dropped{note(&mut notes,"openai:files-dropped");}
+ },
+ ContentBlock::ProviderNative(n)=>{if n.provider=="openai"{flush(&mut parts,&mut input);let mut m=Map::new();deep::insert(&mut m,"type".into(),json!(n.block_type));for(k,v)in &n.data{if k!="id"{deep::insert(&mut m,k.clone(),deep::clone(v));}}input.push(Value::Object(m));}else{note(&mut notes,"openai:anthropic-native-block-dropped");}}
+  }
+            for _ in before..input.len() {
+                turns.push(Some(usize::try_from(turn.max(0)).unwrap_or(0)));
+                provenance.push(std::mem::take(&mut tool_parts));
+            }
+            if matches!(block, ContentBlock::ToolResult(_)) {
+                let start = if input.len() > before { 0 } else { old_parts };
+                tool_parts.extend(start..parts.len());
+            }
+        }
+        let before = input.len();
+        flush(&mut parts, &mut input);
+        if input.len() > before {
+            turns.push(Some(usize::try_from(turn.max(0)).unwrap_or(0)));
+            provenance.push(tool_parts);
+        }
+    }
+    let answered: Vec<String> = input
+        .iter()
+        .filter(|v| v["type"] == "function_call_output")
+        .filter_map(|v| v["call_id"].as_str().map(str::to_owned))
+        .collect();
+    let mut repaired = Vec::new();
+    let mut repaired_turns = Vec::new();
+    let mut repaired_parts = Vec::new();
+    for ((item, turn), parts) in input.into_iter().zip(turns).zip(provenance) {
+        let missing = (item["type"] == "function_call")
+            .then(|| item["call_id"].as_str())
+            .flatten()
+            .filter(|id| !answered.iter().any(|a| a == id))
+            .map(str::to_owned);
+        repaired.push(item);
+        repaired_turns.push(turn);
+        repaired_parts.push(parts);
+        if let Some(id) = missing {
+            repaired.push(json!({"type":"function_call_output","call_id":id,"output":""}));
+            repaired_turns.push(None);
+            repaired_parts.push(Vec::new());
+        }
+    }
+    let instructions = crate::system::system_text(req.system.as_deref(), "openai", &mut |s| {
+        note(&mut notes, s)
+    });
+    let supplied = req.vendor_bag("openai").and_then(|v| {
+        ["prompt_cache_key", "session_id"]
+            .into_iter()
+            .find_map(|k| {
+                v.get(k).and_then(Value::as_str).filter(|s| {
+                    !s.is_empty() && s.len() <= 1024 && s.bytes().all(|b| (33..=126).contains(&b))
+                })
+            })
+    });
+    let seed = if let Some(s) = supplied {
+        jsjson::to_string(&json!({"key":s}))
+    } else if let Some(c) = req.conversation_id.as_ref().filter(|c| !c.is_empty()) {
+        jsjson::to_string(&json!({"conversation":c}))
+    } else {
+        let mut m = Map::new();
+        deep::insert(
+            &mut m,
+            "instructions".into(),
+            json!(instructions.as_deref().unwrap_or("")),
+        );
+        deep::insert(
+            &mut m,
+            "firstInput".into(),
+            repaired.first().map(deep::clone).unwrap_or(Value::Null),
+        );
+        let v = deep::Owned(Value::Object(m));
+        jsjson::to_string(&v.0)
+    };
+    let secrets = oauth.map(|o| super::identity::secrets_from_map(&o.credentials.provider_data));
+    let salt = secrets.as_ref().and_then(|s| s.id_salt.as_deref());
+    let key = supplied
+        .filter(|s| uuid(s))
+        .map(str::to_owned)
+        .unwrap_or_else(|| thread(&omni_crypto::codex::keyed(salt, &seed)));
+    let catalog = super::oauth::catalog(model);
+    let mut lite_tools = None;
+    let mut body = Map::new();
+    deep::insert(&mut body, "model".into(), json!(model));
+    deep::insert(
+        &mut body,
+        "input".into(),
+        Value::Array(repaired.iter().map(deep::clone).collect()),
+    );
+    deep::insert(&mut body, "stream".into(), json!(req.stream));
+    deep::insert(&mut body, "store".into(), json!(false));
+    if let Some(s) = instructions
+        .as_ref()
+        .filter(|s| !s.is_empty() && oauth.is_none())
+    {
+        deep::insert(&mut body, "instructions".into(), json!(s));
+    }
+    if let Some(n) = req.max_tokens {
+        if oauth.is_some() {
+            note(&mut notes, "openai:max-tokens-dropped");
+        } else {
+            deep::insert(
+                &mut body,
+                "max_output_tokens".into(),
+                omni_ir::stream::number(n),
+            );
+        }
+    }
+    if let Some(n) = req.temperature {
+        if oauth.is_some() {
+            note(&mut notes, "openai:temperature-dropped");
+        } else {
+            deep::insert(&mut body, "temperature".into(), omni_ir::stream::number(n));
+        }
+    }
+    if let Some(tools) = &req.tools {
+        let mut out = Vec::new();
+        for t in tools {
+            if let ToolDef::Portable(t) = t {
+                let mut m = Map::new();
+                deep::insert(&mut m, "type".into(), json!("function"));
+                deep::insert(&mut m, "name".into(), json!(t.name));
+                if let Some(d) = &t.description {
+                    deep::insert(&mut m, "description".into(), json!(d));
+                }
+                if oauth.is_some() {
+                    deep::insert(&mut m, "strict".into(), json!(false));
+                }
+                deep::insert(&mut m, "parameters".into(), deep::clone(&t.input_schema));
+                out.push(Value::Object(m));
+            }
+        }
+        if out.len() != tools.len() {
+            note(&mut notes, "openai:anthropic-tool-dropped");
+        }
+        if oauth.is_some() && catalog.lite {
+            lite_tools = Some(out);
+        } else {
+            deep::insert(&mut body, "tools".into(), Value::Array(out));
+        }
+    }
+    if let Some(c) = &req.tool_choice {
+        deep::insert(
+            &mut body,
+            "tool_choice".into(),
+            match c {
+                ToolChoice::Auto => json!("auto"),
+                ToolChoice::Any => json!("required"),
+                ToolChoice::None => json!("none"),
+                ToolChoice::Tool { name } => json!({"type":"function","name":name}),
+            },
+        );
+    }
+    if oauth.is_some() {
+        if req.tool_choice.is_none() {
+            deep::insert(&mut body, "tool_choice".into(), json!("auto"));
+        }
+        deep::insert(
+            &mut body,
+            "parallel_tool_calls".into(),
+            json!(!catalog.lite),
+        );
+        let mut effort = catalog.effort;
+        let mut summary = false;
+        match &req.reasoning {
+            Some(ReasoningConfig::Off) => {
+                effort = "low";
+                note(&mut notes, "openai:reasoning-off-as-lowest");
+            }
+            Some(ReasoningConfig::BetweenTools) => {
+                effort = "low";
+                note(&mut notes, "openai:reasoning-between-tools-as-lowest");
+            }
+            Some(ReasoningConfig::Budget { .. }) => {
+                note(&mut notes, "openai:reasoning-budget-dropped")
+            }
+            Some(ReasoningConfig::Adaptive {
+                effort: e, display, ..
+            }) => {
+                effort = e.map_or(catalog.effort, |e| e.as_str());
+                summary = !matches!(
+                    display,
+                    Some(ReasoningDisplay::Omitted | ReasoningDisplay::Updates)
+                );
+            }
+            _ => {}
+        }
+        let mut reasoning = Map::new();
+        deep::insert(&mut reasoning, "effort".into(), json!(effort));
+        if summary {
+            deep::insert(&mut reasoning, "summary".into(), json!("auto"));
+        }
+        if catalog.lite {
+            deep::insert(&mut reasoning, "context".into(), json!("all_turns"));
+        }
+        deep::insert(&mut body, "reasoning".into(), Value::Object(reasoning));
+        deep::insert(
+            &mut body,
+            "include".into(),
+            json!(["reasoning.encrypted_content"]),
+        );
+        deep::insert(
+            &mut body,
+            "text".into(),
+            json!({"verbosity":catalog.verbosity}),
+        );
+        if let Some(vendor) = req.vendor_bag("openai") {
+            for (k, v) in vendor {
+                if k == "client_metadata" {
+                    note(&mut notes, "openai:client-metadata-replaced");
+                    continue;
+                }
+                if (k == "text" || k == "reasoning")
+                    && let (Some(ours), Some(theirs)) = (
+                        body.get_mut(k).and_then(Value::as_object_mut),
+                        v.as_object(),
+                    )
+                {
+                    for (name, value) in theirs {
+                        deep::insert(ours, name.clone(), deep::clone(value));
+                    }
+                } else {
+                    deep::insert(&mut body, k.clone(), deep::clone(v));
+                }
+            }
+        }
+    } else {
+        match &req.reasoning {
+            Some(ReasoningConfig::BetweenTools) => {
+                note(&mut notes, "openai:reasoning-between-tools-as-off")
+            }
+            Some(ReasoningConfig::Budget { .. }) => {
+                note(&mut notes, "openai:reasoning-budget-dropped")
+            }
+            Some(ReasoningConfig::Adaptive {
+                effort, display, ..
+            }) => {
+                let mut r = Map::new();
+                deep::insert(
+                    &mut r,
+                    "effort".into(),
+                    json!(effort.map_or("medium", |e| e.as_str())),
+                );
+                if !matches!(
+                    display,
+                    Some(ReasoningDisplay::Omitted | ReasoningDisplay::Updates)
+                ) {
+                    deep::insert(&mut r, "summary".into(), json!("auto"));
+                }
+                deep::insert(&mut body, "reasoning".into(), Value::Object(r));
+            }
+            _ => {}
+        }
+        omni_ir::js::object_assign(&mut body, req.vendor_value("openai"));
+    }
+    if let Some(n) = crate::response_format::move_to_responses_text(req, &mut body, "openai") {
+        note(&mut notes, n);
+    }
+    deep::insert(&mut body, "prompt_cache_key".into(), json!(key));
+    let mut headers = Vec::new();
+    if let Some(opts) = oauth {
+        let effort = body
+            .get("reasoning")
+            .and_then(|v| v.get("effort"))
+            .and_then(Value::as_str)
+            .filter(|e| super::oauth::is_effort(e))
+            .map(str::to_owned);
+        let args = super::lite::LiteArgs {
+            thread_id: key.clone(),
+            input: repaired,
+            tools: lite_tools,
+            instructions,
+            request_id: opts.request_id.map(str::to_owned),
+            started_at: opts.request_started_at,
+            id_salt: salt.map(str::to_owned),
+            lite: catalog.lite,
+            effort_update: effort.clone().filter(|_| catalog.updates),
+        };
+        let built = super::lite::to_lite(&args, &repaired_turns, &repaired_parts);
+        deep::insert(&mut body, "input".into(), deep::clone(&built.0["input"]));
+        let (metadata, protocol) = super::oauth::turn(
+            opts,
+            &key,
+            &seed,
+            &built.0,
+            effort.as_deref().unwrap_or(catalog.effort),
+        );
+        deep::insert(&mut body, "client_metadata".into(), metadata);
+        headers = protocol;
+    } else {
+        for item in repaired {
+            deep::drop(item);
+        }
+    }
+    (body, notes, key, headers)
+}
+#[cfg(test)]
+mod tests {
+    #![allow(clippy::unwrap_used)]
+    #[test]
+    fn wire_order_matches_real_ts() {
+        let run = std::process::Command::new("bun")
+            .arg("tests/openai-request-reference.ts")
+            .current_dir(env!("CARGO_MANIFEST_DIR"))
+            .output()
+            .unwrap();
+        assert!(run.status.success());
+        let rows: serde_json::Value = serde_json::from_slice(&run.stdout).unwrap();
+        for row in rows.as_array().unwrap() {
+            let req = serde_json::from_value(row["request"].clone()).unwrap();
+            omni_ir::deep::scope(|| {
+                let (body, notes, key) = super::encode(&req, row["model"].as_str().unwrap());
+                let body = omni_ir::deep::Owned(serde_json::Value::Object(body));
+                assert_eq!(
+                    omni_ir::jsjson::to_string(&body.0),
+                    row["wire"].as_str().unwrap()
+                );
+                assert_eq!(serde_json::json!(notes), row["notes"]);
+                assert_eq!(key, row["key"].as_str().unwrap());
+            });
+        }
+    }
+}
