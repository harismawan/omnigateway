+    closed(&mut peer).await;
+}
+
+#[tokio::test]
+async fn nonreusable_not_adopted() {
+    let p = pool();
+    let (mut body, mut peer) = pair(&p).await;
+    body.drain_test_remainder(b"", false);
+    body.finish_if_ready();
