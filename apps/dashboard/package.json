{
  "name": "@omni/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:routes": "NODE_ENV=production tsr generate",
    "dev": "vite",
    "test": "bun test --preload ./test/setup/happydom.ts --preload ./test/setup/cleanup.ts ./test",
    "typecheck": "bun run generate:routes && tsc --noEmit",
    "build:shared": "vite build --config vite.shared.config.ts",
    "build": "bun run typecheck && vite build && bun run build:shared",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@omnigateway/dashboard-sdk": "workspace:*",
    "@omni/ir": "workspace:*",
    "@omni/store": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.2",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-styled-components": "^2.3.0",
    "vite": "^8.2.2"
  }
}
