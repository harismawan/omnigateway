{
  "name": "@omni/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:routes": "NODE_ENV=production tsr generate",
    "dev": "vite",
    "test": "bun test --preload ./test/setup/happydom.ts --preload ./test/setup/cleanup.ts ./test",
    "typecheck": "bun run generate:routes && tsc --noEmit",
    "build:shared": "vite build --config vite.shared.config.ts",
    "build": "bun run typecheck && vite build && bun run build:shared",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@omnigateway/dashboard-sdk": "workspace:*",
    "@omni/ir": "workspace:*",
    "@omni/store": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-cli": "1.167.27",
    "@tanstack/router-plugin": "^1.168.29",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-styled-components": "^2.3.0",
    "vite": "^8.2.1"
  }
}
