{
  "name": "omnigateway",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "build:dashboard": "cd apps/dashboard && bun run build",
    "dev:dashboard": "cd apps/dashboard && bun run dev",
    "test": "bun run test:scripts && bun run test:dashboard",
    "test:scripts": "bun test scripts",
    "test:dashboard": "bun run --cwd apps/dashboard test",
    "lint": "biome check .",
    "check:claims": "bun run scripts/stale-claims.ts",
    "check:dead": "bun run scripts/dead-exports.ts",
    "fmt": "biome format --write .",
    "typecheck:scripts": "bun check --no-pretty -p tsconfig.json",
    "typecheck:dashboard": "bun run --cwd apps/dashboard typecheck",
    "typecheck": "bun run typecheck:scripts && bun run typecheck:dashboard",
    "build:npm": "bun scripts/build-npm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.3",
    "bun-types": "^1.4.4"
  },
  "overrides": {
    "bun-types": "^1.4.4"
  }
}
