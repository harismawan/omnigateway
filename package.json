{
  "name": "omnigateway",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/gateway/src/index.ts",
    "start": "bun apps/gateway/src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5.7.0"
  }
}
