{
  "name": "omnigateway",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/gateway/src/index.ts",
    "build:dashboard": "cd apps/dashboard && bun run build",
    "dev:dashboard": "cd apps/dashboard && bun run dev",
    "start": "bun apps/gateway/src/index.ts",
    "test": "bun test",
    "test:dashboard": "bun run --cwd apps/dashboard test",
    "test:all": "bun test && bun run test:dashboard && bun run test:plugins",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "typecheck:core": "tsc --noEmit --pretty false -p tsconfig.json",
    "typecheck:dashboard": "bun run --cwd apps/dashboard typecheck",
    "typecheck": "bun run typecheck:core && bun run typecheck:dashboard && bun run --cwd plugins/pokemon typecheck",
    "build:npm": "bun scripts/build-npm.ts",
    "test:plugins": "bun run --cwd plugins/pokemon test:ui",
    "build:plugins": "bun run --cwd plugins/pokemon build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
