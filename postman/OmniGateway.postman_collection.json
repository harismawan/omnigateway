    {
      "name": "OAuth Connections",
      "description": "Start returns one of redirect, manual-paste, or device-code flow metadata. Use Finish for manual-paste flows, Poll for Kimi device flow, and provider browser redirect for callback flow.",
      "item": [
        {
          "name": "Start Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/connect/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connect", "start"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{provider}}\",\n  \"label\": \"{{provider}} account\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Connection flow starts\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.flowId) pm.environment.set(\"flowId\", body.flowId);",
                  "if (body.state) pm.environment.set(\"oauthState\", body.state);"
                ]
              }
            }
          ]
        },
        {
          "name": "Finish Manual Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/connect/finish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connect", "finish"]
            },
            "description": "Used when Start Connection returns a manual-paste flow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flowId\": \"{{flowId}}\",\n  \"code\": \"{{oauthCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request completed\", function () {",
                  "  pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll Device Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/connect/poll",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connect", "poll"]
            },
            "description": "Used for Kimi device authorization. Repeat while response is 202 pending.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flowId\": \"{{flowId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Device flow is pending or complete\", function () {",
                  "  pm.expect([200, 202]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OAuth Browser Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth/callback?state={{oauthState}}&code={{oauthCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["oauth", "callback"],
              "query": [
                {
                  "key": "state",
                  "value": "{{oauthState}}"
                },
                {
                  "key": "code",
                  "value": "{{oauthCode}}"
                },
                {
                  "key": "error",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Browser-facing HTML callback. Normally invoked by provider redirect, not manually. Use only for diagnostics."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request completed\", function () {",
                  "  pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
